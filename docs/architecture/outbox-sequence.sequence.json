  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-broker outbox",
      "items": [
        "the enqueue rides the same DB transaction as the state change — no dual-write gap, no job lost on commit",
        "the outbox row is the durability boundary; Redis only holds the queue and its dead-letter queue"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "the claimed row is bumped into a BullMQ job keyed to the outbox id; consumers check-before-act, so a retried job never double-sends",
        "the sender is an adapter: console under the offline switch, SMTP otherwise — selection, not refactor"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure + purge",
      "items": [
        "retries use capped exponential backoff; a poison job dead-letters and stays visible in the table and logs",
        "the janitor sweeps expired sessions, verifications and reset codes on its own loop — never rotation history, never audit rows"
      ]
    }
  ]
