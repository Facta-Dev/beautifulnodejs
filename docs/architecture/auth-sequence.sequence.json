  "cards": [
    {
      "dot": "cyan",
      "title": "One transaction",
      "items": [
        "signup writes the user, the verification-code row and the outbox row in the same Drizzle transaction",
        "the row, not the BullMQ job, is the durability boundary — Redis down degrades delivery, never committed data"
      ]
    },
    {
      "dot": "emerald",
      "title": "Code lifecycle",
      "items": [
        "codes expire in 24h, cap wrong guesses and are consumed on verify",
        "resend never reveals whether the account exists; an already-verified email answers 409"
      ]
    },
    {
      "dot": "rose",
      "title": "Login + tokens",
      "items": [
        "password first — one constant 401; then the stable 403 gates: blocked, inactive, unverified",
        "access JWT 15m; the opaque refresh rotates in place — a replayed token misses the compare-and-swap and answers 401"
      ]
    }
  ]
