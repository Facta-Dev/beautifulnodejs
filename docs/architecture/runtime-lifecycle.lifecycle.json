{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "beautifulnodejs Runtime Lifecycle",
    "output": "runtime-lifecycle.lifecycle.html",
    "quality_profile": "showcase"
  },
  "mainPath": [
    "boot",
    "wire",
    "serve",
    "ready",
    "flow"
  ],
  "states": [
    {
      "id": "boot",
      "type": "start",
      "label": "config.Load",
      "sublabel": "zod · fails closed",
      "step": "01",
      "tag": "entry"
    },
    {
      "id": "wire",
      "type": "active",
      "label": "wire deps",
      "sublabel": "Pool → PgBouncer · slices",
      "step": "02"
    },
    {
      "id": "serve",
      "type": "active",
      "label": "http serve",
      "sublabel": "Pino · OTel",
      "step": "03"
    },
    {
      "id": "ready",
      "type": "decision",
      "label": "readyz gate",
      "sublabel": "SELECT 1, 2s cap",
      "step": "04",
      "tag": "gate"
    },
    {
      "id": "flow",
      "type": "success",
      "label": "Request flow",
      "sublabel": "slices · envelope",
      "step": "05",
      "tag": "done"
    },
    {
      "id": "authfail",
      "type": "waiting",
      "label": "401 · 403 gate",
      "sublabel": "auth guards",
      "tag": "pause"
    },
    {
      "id": "drain",
      "type": "active",
      "label": "Drain loop",
      "sublabel": "BullMQ drain · idempotent",
      "tag": "automatic"
    },
    {
      "id": "mfail",
      "type": "failure",
      "label": "Exit 1",
      "sublabel": "fails closed",
      "tag": "terminal"
    },
    {
      "id": "degraded",
      "type": "failure",
      "label": "503 readyz",
      "sublabel": "drift",
      "tag": "terminal"
    },
    {
      "id": "recovered",
      "type": "success",
      "label": "Sent / Recovered",
      "sublabel": "settle · janitor",
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "id": "t-boot-wire",
      "from": "boot",
      "to": "wire"
    },
    {
      "id": "t-wire-serve",
      "from": "wire",
      "to": "serve"
    },
    {
      "id": "t-serve-ready",
      "from": "serve",
      "to": "ready"
    },
    {
      "id": "t-ready-flow",
      "from": "ready",
      "to": "flow"
    },
    {
      "id": "t-serve-authfail",
      "from": "serve",
      "to": "authfail",
      "label": "bad token",
      "variant": "security"
    },
    {
      "id": "t-ready-degraded",
      "from": "ready",
      "to": "degraded",
      "label": "DB down",
      "variant": "dashed"
    },
    {
      "id": "t-flow-drain",
      "from": "flow",
      "to": "drain",
      "label": "side effect",
      "variant": "security"
    },
    {
      "id": "t-drain-recovered",
      "from": "drain",
      "to": "recovered",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Boot rail",
      "items": [
        "each root is one function: zod config → Pool behind PgBouncer → platform → register* per slice → outbox worker → listen",
        "nothing migrates at startup — drizzle-kit migrations are a deploy step, so replicas cannot race and drift shows at readyz instead",
        "SIGTERM/SIGINT run stop(): abort the worker, app.close(), pool.end()"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gates + recovery",
      "items": [
        "requireAuth answers the 401 envelope, requireRole the 403; /healthz and /readyz sit outside the hook chain",
        "the worker drains through the BullMQ outbox: claim → queue → idempotent consumer → capped retries → dead-letter",
        "Pino child loggers carry requestId + trace_id; OTel spans sit at the edges, Prometheus at the boundary — never in the domain"
      ]
    },
    {
      "dot": "rose",
      "title": "Explicit endings",
      "items": [
        "config validation fails closed at boot — a placeholder JWT secret or bad duration is Exit 1 in 200ms",
        "readyz pings the pool with a 2s timeout and answers the 503 envelope when the schema or the DB is unreachable",
        "WS auth happens after upgrade — a bad ?token= closes with code 4001 authentication_failed; SSE teardown cancels on disconnect"
      ]
    }
  ]
}