    "bullmq": "^5.66.6",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.39.2",
    "eslint-plugin-n": "^17.23.1",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
